   },
   {
    "id": "0c4e35c",
    "elType": "widget",
    "widgetType": "accordion",
    "settings": {
     "tabs": [
      {
       "_id": "43ee1cb",
       "tab_title": "How does a project start?",
       "tab_content": "<p>With a short call. After that you receive a written plan with the scope, the timeline and a fixed price. Work starts when you approve it.</p>"
      },
      {
       "_id": "7b1f30d",
       "tab_title": "Can I update my website myself?",
       "tab_content": "<p>Yes. We build on WordPress and show you how to change text, images and prices. You also receive a short written guide.</p>"
      },
      {
       "_id": "4072884",
       "tab_title": "Do you work with businesses in other countries?",
       "tab_content": "<p>Yes. We work remotely with clients in different countries and time zones.</p>"
      },
      {
       "_id": "50408b5",
       "tab_title": "What happens after launch?",
       "tab_content": "<p>You can look after the site yourself, or choose a care plan where we handle updates, backups and small changes.</p>"
      }
     ],
     "title_html_tag": "h3",
